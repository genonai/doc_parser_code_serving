.gitignore
.dockerignore
.venv/
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.DS_Store
.idea/
offline-dev-kit/
wheelhouse/
genon/preprocessor/examples/facade_run/result.json
genon/preprocessor/tools/parse_chunk/result_parse_chunk/
genon/preprocessor/tools/facade_test/result_facade_test/
